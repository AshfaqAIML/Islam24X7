# Production database — hosted Postgres (e.g. a free Neon project).
# Paste the pooled connection string here, then run `bunx prisma db push`
# once to create the tables (BookUpload and the rest).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Live Knowledge Base backend — set both to point at a running `kb serve`
# (e.g. http://127.0.0.1:8000). When unset the site serves clearly-labeled
# demo data instead.
KNOWLEDGE_BASE_API_URL=http://127.0.0.1:8000
AI_API_URL=http://127.0.0.1:8000

# --- Book uploads: object storage (production path for real books) ---
# S3-compatible store, e.g. Cloudflare R2. When ALL of these are set,
# /admin/upload streams files directly to the bucket (presigned URLs) so
# ~1000-page volumes bypass serverless body limits. When unset, uploads
# fall back to local disk (dev only).
#
# R2 endpoint looks like: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=islam24x7-books
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL the website/app downloads from — an r2.dev subdomain or
# your own domain mapped to the bucket, e.g. https://books.example.com
S3_PUBLIC_BASE_URL=

# --- Admin access (website operator console) ---
# Login for /admin is email + password via NextAuth credentials.
ADMIN_EMAIL=moeedkamraan1123@gmail.com
# scrypt hash, NOT the password: generate with `bun scripts/make-admin-hash.ts <password>`
ADMIN_PASSWORD_HASH=
# Random 32+ byte secret for session signing: `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Knowledge-Base pipeline (Python) ---
# Never commit real values.
KB_DATA_DIR=./data
KB_LOG_LEVEL=INFO

# PostgreSQL (dev/test via local pgvector container on port 5434)
KB_DATABASE_URL=postgresql+psycopg://knowledge_base:islam24x7_dev@localhost:5434/knowledge_base
KB_TEST_DATABASE_URL=postgresql+psycopg://knowledge_base:islam24x7_dev@localhost:5434/knowledge_base_test

# Embedding pipeline
# provider: 'dummy' (local/dev) or a 'pkg.module:ClassName' path for your own.
# KB_EMBEDDING_PROVIDER=dummy
# KB_EMBEDDING_MODEL=kb-dummy
# KB_EMBEDDING_MODEL_VERSION=0.1.0
# KB_EMBEDDING_DIMENSIONS=768
# KB_EMBEDDING_BATCH_SIZE=64
# KB_EMBEDDING_MAX_RETRIES=3
# KB_EMBEDDING_BACKOFF_SECONDS=1.0
# KB_EMBEDDING_CALLS_PER_MINUTE=0
